load("@protobuf//bazel:proto_library.bzl", "proto_library")
load("@rules_go//go:def.bzl", "go_library")
load("@rules_go//proto:def.bzl", "go_proto_library")

proto_library(
    name = "schedulerstate_proto",
    srcs = ["schedulerstate.proto"],
    import_prefix = "github.com/buildbarn/bb-remote-execution",
    visibility = ["//visibility:public"],
    deps = [
        "//pkg/proto/buildqueuestate:buildqueuestate_proto",
        "//pkg/proto/remoteworker:remoteworker_proto",
        "@bazel_remote_apis//build/bazel/remote/execution/v2:remote_execution_proto",
        "@protobuf//:any_proto",
        "@protobuf//:duration_proto",
        "@protobuf//:timestamp_proto",
    ],
)

go_proto_library(
    name = "schedulerstate_go_proto",
    importpath = "github.com/buildbarn/bb-remote-execution/pkg/proto/schedulerstate",
    proto = ":schedulerstate_proto",
    visibility = ["//visibility:public"],
    deps = [
        "//pkg/proto/buildqueuestate",
        "//pkg/proto/remoteworker",
        "@bazel_remote_apis//build/bazel/remote/execution/v2:remote_execution_go_proto",
    ],
)

go_library(
    name = "schedulerstate",
    embed = [":schedulerstate_go_proto"],
    importpath = "github.com/buildbarn/bb-remote-execution/pkg/proto/schedulerstate",
    visibility = ["//visibility:public"],
)
